# ════════════════════════════════════════════════
#  ConnectBé — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ════════════════════════════════════════════════

# ── Base de données ───────────────────────────────
DB_ROOT_PASSWORD=change_me_root
DB_NAME=connectbe_kiosk
DB_USER=connectbe_user
DB_PASSWORD=change_me_db
DB_HOST=mysql
DB_PORT=3306

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Backend ───────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=change_me_jwt_secret_32chars

# ── APIs externes ─────────────────────────────────
OPENWEATHERMAP_API_KEY=       # https://openweathermap.org/api
FLIGHTAPI_KEY=                 # https://www.flightapi.io
ORS_API_KEY=                  # https://openrouteservice.org/dev/#/signup (gratuit) — utilisée côté backend uniquement (proxy /api/directions)
VITE_CARTO_API_KEY=           # https://carto.com/basemaps (gratuit) — sans clé, fond de carte affiche "API KEY REQUIRED"

# ── Localisation hôtel ────────────────────────────
HOTEL_NAME=ConnectBé
HOTEL_LAT=12.3641
HOTEL_LNG=-1.5332
HOTEL_CITY_OWM_ID=2355426     # ID OpenWeatherMap Ouagadougou
HOTEL_AIRPORT_IATA=OUA        # Code IATA aéroport Ouagadougou
HOTEL_PHONE=+22625000000
HOTEL_EMAIL=contact@connectbe.bf

# ── Backoffice Admin ──────────────────────────────
# Mot de passe initial du compte super-admin (admin@iconnectbe.com), appliqué UNE SEULE FOIS
# au premier démarrage du backend — tant que le hash en base est encore le placeholder posé
# par la migration 001. Sans changement de code, remplir cette variable ne suffisait pas ;
# voir backend/src/services/runMigrations.js (migration016).
# Ensuite, changer le mot de passe se fait via le backoffice (page Utilisateurs).
ADMIN_PASSWORD=connectbe2026      # Changer en production !

# ── Kiosque ───────────────────────────────────────
IDLE_TIMEOUT_MS=60000         # Retour menu après Nms d'inactivité

# ── Sauvegarde / restauration de configuration ────
# Emplacements utilisés par le module Sauvegarde & restauration du back-office.
# Valeurs par défaut correctes en conteneur (/uploads et /backups sont montés
# par docker-compose) comme en local (uploads/ et backups/ du dépôt). À ne
# renseigner que pour ranger les fichiers ailleurs.
# UPLOADS_DIR=/uploads
# CONFIG_BACKUP_DIR=/backups/config

# ── Confiance proxy ───────────────────────────────
# À définir dès qu'nginx (ou Cloudflare) est devant le backend, ce qui est le cas
# en production : sans cette variable, req.ip vaut l'adresse du proxy pour TOUS les
# clients. Conséquence concrète : les limitations de débit deviennent un compteur
# unique partagé par l'ensemble des visiteurs, et les IP journalisées sont inutiles.
TRUST_PROXY=1

# ── Accès client par code de séjour ───────────────
# Le client saisit un code court (remis à l'enregistrement) sur
# /<slug-hotel>/visiteur et retrouve tout le menu sur son téléphone.

# Marge de courtoisie après l'heure de départ, en heures. N'est que la valeur
# proposée à la création : chaque code porte la sienne en base.
GUEST_GRACE_HOURS=24

# Rétention avant purge RGPD, en jours après la fin d'accès réelle. Passé ce
# délai, les appareils rattachés sont supprimés et le nom du client effacé.
GUEST_RETENTION_DAYS=30

# Verrouillage des routes de contenu (météo, vols, POI, services…). Ces routes
# étaient entièrement publiques : n'importe qui pouvait lire les données d'un
# hôtel en connaissant son id.
#   false (défaut) : mode observation — les appels sans jeton passent mais sont
#                    journalisés. À déployer d'abord ainsi, le temps de vérifier
#                    dans les journaux qu'aucun appel légitime ne tombe.
#   true           : verrouillé — un jeton de borne, de visiteur ou de QR mobile
#                    est exigé. Les bornes doivent avoir rechargé le front à jour.
CONTENT_AUTH_ENFORCE=false

# Budget d'échecs de saisie par minute et par client, contre la force brute sur le
# code. Seules les saisies FAUSSES le consomment : un code valide est toujours servi,
# même si d'autres viennent d'échouer. 20 échecs/min face à ~729 millions de
# combinaisons rendent l'essai exhaustif hors de portée.
GUEST_FAILURE_BUDGET=20
